-- ==========================================
-- 4. LÓGICA DE FONDO
-- ==========================================
local ammoTexture = nil
local weapon1, ultmbala = 0, 0
local listArmas = {[22]=17, [23]=17, [24]=7, [25]=1, [26]=2, [27]=7, [28]=50, [29]=30, [30]=30, [31]=50, [32]=300, [33]=1, [34]=1, [35]=1, [36]=1}

function DrawStretchedText(text, x, y, color, borderColor, borderSize)
    if not fontAmmo then return end
    local dl = m.GetBackgroundDrawList()
    local oldScale = fontAmmo.Scale
    fontAmmo.Scale = gui.width_scale[0]
    m.PushFont(fontAmmo)
    for dx = -borderSize, borderSize do
        for dy = -borderSize, borderSize do
            if dx ~= 0 or dy ~= 0 then dl:AddText(m.ImVec2(x + dx, y + (dy * gui.height_scale[0])), borderColor, text) end 
        end 
    end
    dl:AddText(m.ImVec2(x, y), color, text)
    m.PopFont()
    fontAmmo.Scale = oldScale
end

m.OnFrame(function() return not isPauseMenuActive() end, function()
    local weapon = getCurrentCharWeapon(PLAYER_PED)
    if weapon ~= weapon1 then weapon1 = weapon; if listArmas[weapon] then ultmbala = listArmas[weapon] end end
    if isCharShooting(PLAYER_PED) and listArmas[weapon] then
        if ultmbala > 0 then ultmbala = ultmbala - 1 end
        if ultmbala == 0 then ultmbala = listArmas[weapon] or 0 end
    end
    local textToDraw = nil
    if listArmas[weapon] then textToDraw = string.format("%d", ultmbala)
    elseif (weapon >= 16 and weapon <= 39) or weapon == 41 or weapon == 42 then textToDraw = string.format("%d", getAmmoInCharWeapon(PLAYER_PED, weapon))
    elseif gui.always_show[0] then textToDraw = "0" end
    if textToDraw then
        local r, g, b, a
        if gui.rgb_mode[0] then
            local t = os.clock() * 1.5; r, g, b = math.sin(t)*.5+.5, math.sin(t+2)*.5+.5, math.sin(t+4)*.5+.5; a = gui.col_text[3]
        else r, g, b, a = gui.col_text[0], gui.col_text[1], gui.col_text[2], gui.col_text[3] end
        local colText = bit.bor(math.floor(r*255), bit.lshift(math.floor(g*255), 8), bit.lshift(math.floor(b*255), 16), bit.lshift(math.floor(a*255), 24))
        local colBorder = bit.bor(math.floor(gui.col_border[0]*255), bit.lshift(math.floor(gui.col_border[1]*255), 8), bit.lshift(math.floor(gui.col_border[2]*255), 16), bit.lshift(math.floor(gui.col_border[3]*255), 24))
        if gui.img_enabled[0] and ammoTexture then renderDrawTexture(ammoTexture, gui.img_pos_x[0], gui.img_pos_y[0], gui.img_size[0], gui.img_size[0], 0.0, -1) end
        DrawStretchedText(textToDraw, gui.pos_x[0], gui.pos_y[0], colText, colBorder, gui.border[0])
    end
end)

function main()
    if thisScript().filename:match("([^\\/]+)%.luac?$") ~= script_name_fixed then
        while not isSampAvailable() do wait(100) end
        sampAddChatMessage("{ff0000}[Seguridad]: {ffffff}No renombres el script.", -1); thisScript():unload(); return
    end
    if doesFileExist(texturePath) then ammoTexture = renderLoadTextureFromFile(texturePath) end
    while not isSampAvailable() do wait(200) end
    sampRegisterChatCommand("ammo", function() renderWindow[0] = not renderWindow[0] end)
    while true do wait(0) m.Process = renderWindow[0] end
end
